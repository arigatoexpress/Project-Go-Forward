# Google Cloud / Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
THO_GEMINI_MODEL=gemini-2.5-flash
THO_GEMINI_FALLBACK_MODELS=gemini-2.0-flash-001
THO_IMAGEN_MODEL=imagen-4.0-generate-001
THO_IMAGEN_FALLBACK_MODELS=imagen-3.0-generate-002,imagen-3.0-generate-001
THO_VEO_MODEL=veo-3.0-fast-generate-001

# Public inventory source (safe default: legacy snapshot).
# `auto` fails closed to legacy unless a strict Firestore-only loader reports
# explicit `firestore_inventory` provenance AND a fresh source timestamp.
# The current resilient marketing loader has JSON/sample fallbacks and reports
# `inventory_fallback_chain`, so a non-empty result alone cannot auto-activate.
INVENTORY_SOURCE=legacy
INVENTORY_FIRESTORE_MIN_HOMES=1
LEGACY_SNAPSHOT_STALE_DAYS=14

# Admin Authentication (required in production)
# Generate hash: python -c "import hashlib; print(hashlib.sha256(b'YOUR_PIN').hexdigest())"
ADMIN_PIN_HASH=
ADMIN_TOKEN_TTL=7200

# Email Service (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx
# Resend verified sender (must be domain-verified in Resend dashboard before use)
RESEND_FROM="Texas Home Outlet <noreply@texashomeoutlet.com>"
# Public origin used to build absolute download URLs in customer emails (no trailing slash)
PUBLIC_SITE_URL=https://your-app.run.app

# UTM tagging on Ad Studio CTA links (fail-closed; OFF unless explicitly enabled).
# When enabled, the scheduler appends "<PUBLIC_SITE_URL>/?utm_source=...&utm_medium=...
# &utm_campaign=<home-slug>" to the outbound caption. utm_campaign derives from the
# featured home/plan name; falls back to config.yaml business.website if
# PUBLIC_SITE_URL is unset. Leave unset/0 to keep captions unchanged.
THO_UTM_CTA_ENABLED=0
# Optional overrides (defaults: utm_source=<platform>, utm_medium=social)
THO_UTM_SOURCE=
THO_UTM_MEDIUM=

# Analytics / ad pixels (opt-in, runtime-gated; emitted only on indexable pages).
# Set a valid id to activate that tag; malformed/unset = no markup, no CSP change.
# LEGAL: activating ad pixels sets third-party cookies — decide on a cookie/consent
# policy before enabling Meta/TikTok. og:image for social-share cards: OG_IMAGE_URL.
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
OG_IMAGE_URL=

# Per-route rate limits (operator-tunable; blank = conservative 10/min default).
# Throttles /api/contact and /api/appointments to stop form-flood/email-flood on
# the fresh Resend sending domain. Format "<count>/<minute|hour>".
CONTACT_RATE_LIMIT=
APPOINTMENTS_RATE_LIMIT=

# Google Ads PAUSED-create owner approval/outbox. All defaults are inert. Set
# only after the read-only readiness audit, least-privilege IAM review, and
# fresh account-access evidence are green for the exact APP_VERSION. Dispatch
# is a separate Ari gate; none of these authorize activation or spend.
THO_GOOGLE_ADS_PAUSED_CREATE_APPROVAL_ENABLED=false
THO_GOOGLE_ADS_PAUSED_CREATE_CLOUD_READINESS_VERIFIED=false
THO_GOOGLE_ADS_PAUSED_CREATE_IAM_VERIFIED=false
THO_GOOGLE_ADS_PAUSED_CREATE_READINESS_REVISION=
THO_GOOGLE_ADS_PAUSED_CREATE_PROJECT=
THO_GOOGLE_ADS_PAUSED_CREATE_REGION=
THO_GOOGLE_ADS_PAUSED_CREATE_JOB=
THO_GOOGLE_ADS_PAUSED_CREATE_DISPATCH_ENABLED=false

# Error monitoring (Sentry) — opt-in. Empty SENTRY_DSN = fully disabled
# (sentry_sdk never imported/initialized; send_default_pii forced False).
SENTRY_DSN=
# Fraction of requests traced for performance, 0.0-1.0 (default 0.05).
SENTRY_TRACES_SAMPLE_RATE=

# Staff who receive new-lead and appointment alerts. The required list is
# additive so a stale Cloud Run NOTIFICATION_EMAIL value cannot silently omit a
# newly added team member. Set it explicitly to an empty value only when an
# operator intentionally removes every required recipient.
NOTIFICATION_EMAIL=ben@texashomeoutlet.com,leeaswell@texashomeoutlet.com,celeste@texashomeoutlet.com,mark@texashomeoutlet.com,adriana@texashomeoutlet.com
REQUIRED_NOTIFICATION_EMAILS=adriana@texashomeoutlet.com

# CORS — comma-separated allowed origins (defaults to Cloud Run URLs)
ALLOWED_ORIGINS=https://your-app.run.app

# Rate Limiting
RATE_LIMIT_RPM=60
MAX_REQUEST_BODY_BYTES=1048576

# Redis Cache (optional — falls back to in-memory)
REDIS_HOST=
REDIS_PORT=6379

# Mira partner API (optional — leave unset to disable the bridge)
# Used by /api/v1/mira/* endpoints. Any env var matching THO_API_KEY_* is
# accepted by require_partner_api_key(); store the actual value in Secret Manager.
THO_API_KEY_MIRA=

# Mira Telegram bot integration (optional — leave unset to disable)
# TELEGRAM_BOT_TOKEN powers the THO bot. KIMI_RELAY_CHAT_ID is the legacy
# fallback; MIRA_GROUP_ID is the dedicated group for the Mira AI agent.
TELEGRAM_BOT_TOKEN=
KIMI_RELAY_CHAT_ID=
MIRA_GROUP_ID=

# GitHub → Mira trigger bridge (optional — leave unset to disable)
# GITHUB_WEBHOOK_SECRET validates inbound X-Hub-Signature-256 headers on
# /api/github/mira/webhook. PARTNER_WEBHOOK_URL_MIRA is where THO sends
# HMAC-signed partner events for the Mira bridge API.
# PARTNER_WEBHOOK_SIGNING_KEY is the shared HMAC secret for outbound webhooks
# (used by tools/partner_webhooks.py and shared across all partner webhooks).
GITHUB_WEBHOOK_SECRET=
PARTNER_WEBHOOK_URL_MIRA=
PARTNER_WEBHOOK_SIGNING_KEY=

# DNS/MX cutover verification (optional — defaults to texashomeoutlet.com targets)
CUTOVER_DOMAIN=texashomeoutlet.com
CUTOVER_WWW_DOMAIN=www.texashomeoutlet.com
# Resend outbound-email subdomain (default "send"; only used for MX health checks)
RESEND_SEND_SUBDOMAIN=send
# Resend DKIM selector used by email-auth health checks (default "resend")
RESEND_DKIM_SELECTOR=resend
# Max recipients allowed in a single send_email() call (default 50)
EMAIL_MAX_RECIPIENTS=50

# Obsidian Sovereign LLM integration (optional — leave unset to disable)
# THO_API_KEY_OBSIDIAN enables the Obsidian plugin to call /api/v1/obsidian/*.
# PARTNER_WEBHOOK_URL_OBSIDIAN is where THO sends HMAC-signed events (e.g. a
# local relay, n8n, or a vault-facing endpoint). PARTNER_WEBHOOK_SIGNING_KEY
# is shared across all partner webhooks and is used to sign the outbound body.
THO_API_KEY_OBSIDIAN=
PARTNER_WEBHOOK_URL_OBSIDIAN=

# Notion source for the Mira bridge (optional — leave unset to use Firestore)
# When set, /api/v1/mira/installations/* and /api/v1/mira/feedback/* read from
# Notion instead of Firestore (the response "source" field reports which backend
# served it). Both the token AND the relevant DB id must be present for that
# source to activate; otherwise the endpoint falls back to Firestore. Responses
# stay PII-redacted regardless of source. See docs/integration/notion-bridge.md.
NOTION_TOKEN=                       # Notion internal integration token (secret_...)
NOTION_DELIVERY_TRACKER_DB_ID=      # installations source DB (Delivery Tracker)
NOTION_CS_SURVEY_DB_ID=             # feedback source DB (CS survey)

# ── Everything below is commented out on purpose ───────────────────────────
# Uncomment only what you need. A blank value is not the same as unset: it can
# override a code default (e.g. REPLY_TO) or, for K_SERVICE, make the app
# behave as if it were running on Cloud Run.

# More Notion source DBs (same token as above)
# NOTION_SERVICE_WARRANTY_DB_ID=      # service/warranty source DB
# NOTION_TITLE_DB_ID=                 # title tracking source DB
# NOTION_COLLECTIONS_DB_ID=           # collections source DB
# NOTION_INSURANCE_DB_ID=             # insurance source DB
# NOTION_TEAM_TASKS_DB_ID=            # team tasks source DB
# NOTION_LEAD_PIPELINE_DB_ID=         # lead pipeline source DB
# Notion Command Center reader for the Ops Copilot (on/off, default off)
# NOTION_COMMAND_CENTER=off
# Mirror new leads into Notion (on/off, default off)
# NOTION_LEAD_SYNC=off

# ── Staff sign-in (email link / 6-digit code, backup PIN) ──────────────────
# Sign-in emails are sent through Resend, so RESEND_API_KEY and RESEND_FROM
# above are required. ADMIN_PIN_HASH above is the emergency backup PIN.
# Signing secret for staff session tokens. REQUIRED on Cloud Run and must be
# independent of the PIN; generate a long random value and keep it in Secret Manager.
# ADMIN_SESSION_SECRET=
# Email login-code store: firestore (default, required on Cloud Run) or memory (local dev)
# THO_EMAIL_CODE_STORE=firestore
# Allow the in-memory code store on Cloud Run (1/true). Leave unset in production.
# THO_EMAIL_CODE_ALLOW_MEMORY_STORE=
# Staff directory store override: firestore or memory (blank = memory locally, firestore on Cloud Run)
# THO_STAFF_DIRECTORY_STORE=
# Comma-separated owner emails; merged with THO_PASSKEY_OWNER_EMAILS into the owner allowlist
# THO_ADMIN_OWNER_EMAILS=owner@example.com
# Feature flag: show the passkey button on the staff sign-in page (default false)
# FF_STAFF_PASSKEY_SIGN_IN=false

# ── WebAuthn / passkeys (hidden from sign-in page by default) ──────────────
# Expected browser origin for passkey ceremonies (default https://www.texashomeoutlet.com)
# WEBAUTHN_ORIGIN=https://www.example.com
# Legacy alias for WEBAUTHN_ORIGIN
# THO_ORIGIN=
# Relying-party ID, the registrable domain (default texashomeoutlet.com)
# WEBAUTHN_RP_ID=example.com
# Legacy alias for WEBAUTHN_RP_ID
# THO_RP_ID=
# Extra origin=rp_id pairs accepted during domain cutovers, comma-separated
# WEBAUTHN_ORIGIN_RP_IDS=https://legacy.example.com=legacy.example.com
# Comma-separated owner emails; merged with THO_ADMIN_OWNER_EMAILS into the owner allowlist
# THO_PASSKEY_OWNER_EMAILS=owner@example.com
# Comma-separated email domains allowed to use passkeys
# THO_PASSKEY_ALLOWED_DOMAINS=example.com
# Allow discoverable (username-less) passkey login (1/0, default 1)
# THO_PASSKEY_DISCOVERABLE_LOGIN=1
# Passkey credential store: firestore (default) or memory (local dev)
# THO_PASSKEY_STORE=firestore
# Allow the in-memory passkey store on Cloud Run (1/true). Leave unset in production.
# THO_PASSKEY_ALLOW_MEMORY_STORE=

# ── Email (Resend) extras ──────────────────────────────────────────────────
# Reply-To header on outbound email (default sales@ the business domain)
# REPLY_TO=sales@example.com
# Svix signing secret for the Resend inbound/events webhook
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
# Comma-separated sender addresses accepted by the inbound email webhook
# INBOUND_EMAIL_ALLOWLIST=
# Max automated email replies per day (default set in email_reply_sender.py)
# EMAIL_REPLY_DAILY_CAP=
# Google review link included in follow-up emails (FF_GOOGLE_REVIEW_LINK_VALUE also works)
# GOOGLE_REVIEW_LINK=
# Call-to-action URL in lead nurture emails
# LEAD_NURTURE_CTA_URL=https://www.example.com

# ── Feature flags (FF_<NAME> or FEATURE_FLAG_<NAME>; also _VALUE / _PERCENT) ─
# Master switch for sending automated email replies
# FF_EMAIL_REPLY_SEND=false
# Send an automatic acknowledgement to inbound emails
# FF_EMAIL_AUTO_ACK=false
# Generate internal reply drafts for inbound emails
# FF_EMAIL_DRAFT_PIPELINE=false
# Require Telegram approval before an automated reply is sent
# FF_EMAIL_TG_GATE=false
# Value form of GOOGLE_REVIEW_LINK
# FF_GOOGLE_REVIEW_LINK_VALUE=

# ── Telegram approval gate for email replies ───────────────────────────────
# Bot token for the email-reply approval gate
# THO_TG_BOT_TOKEN=
# Chat ID that receives approval requests
# THO_TG_CHAT_ID=
# Secret token validating the Telegram webhook
# THO_TG_WEBHOOK_SECRET=

# ── DocuSeal e-signature ───────────────────────────────────────────────────
# Base URL of the DocuSeal instance (no trailing slash)
# DOCUSEAL_API_URL=https://docuseal.example.com
# DocuSeal API token (Secret Manager)
# DOCUSEAL_API_TOKEN=
# Shared secret validating DocuSeal webhooks
# DOCUSEAL_WEBHOOK_SECRET=

# ── Google Ads ─────────────────────────────────────────────────────────────
# Comma-separated Google Ads owner emails; must exactly match the owner allowlist above
# THO_GOOGLE_ADS_OWNER_EMAILS=owner@example.com
# Step-up evidence store: firestore (default) or memory (local dev)
# THO_GOOGLE_ADS_STEP_UP_STORE=firestore
# Used by scripts/google_ads_* jobs and probes only
# GOOGLE_ADS_CUSTOMER_ID=000-000-0000
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_DEVELOPER_TOKEN=

# ── Storage buckets and documents ──────────────────────────────────────────
# Bucket for generated/signed documents (default tho-secure-documents)
# GCS_DOCUMENTS_BUCKET=your-documents-bucket
# Bucket for staff-uploaded listing photos, stored per home id (default tho-listing-photos)
# GCS_LISTING_PHOTOS_BUCKET=your-listing-photos-bucket
# Local-disk fallback directory for listing photos in dev
# THO_LISTING_PHOTOS_DIR=
# Seconds to cache the grouped listing-photo index (default 60)
# THO_LISTING_PHOTOS_CACHE_TTL=60
# Skip all GCS uploads (1/true), for tests and offline dev
# THO_DISABLE_GCS_UPLOADS=
# Skip photo resizing/re-encoding (1/true)
# THO_DISABLE_IMAGE_PROCESSING=
# Photo upload limits (defaults: 15 MB, 2400 px, 40M px, 80M decoded px, 500 frames, JPEG 85)
# THO_MAX_PHOTO_BYTES=15728640
# THO_MAX_IMAGE_DIM=2400
# THO_MAX_IMAGE_PIXELS=40000000
# THO_MAX_DECODED_PIXELS=80000000
# THO_MAX_IMAGE_FRAMES=500
# THO_JPEG_QUALITY=85
# Cloud KMS key for encrypting SSN fields: projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k> (blank = inert)
# SSN_KMS_KEY=
# Hide document history created before this ISO timestamp
# DOCUMENT_HISTORY_MIN_CREATED_AT=
# Comma-separated filename markers hidden from document history
# DOCUMENT_HISTORY_QUARANTINE_MARKERS=

# ── Google Drive ───────────────────────────────────────────────────────────
# Root folder ID for mirrored customer records
# DRIVE_RECORDS_ROOT_ID=
# Turn off Drive mirroring (1/true)
# THO_DISABLE_DRIVE_MIRRORING=
# Source folder ID for the floorplan sync job
# DRIVE_FOLDER_ID=
# Floorplan sync dry run (1 = no writes)
# DRIVE_SYNC_DRY_RUN=1

# ── Google Cloud / Firestore extras ────────────────────────────────────────
# Alternate project ID names read by some modules (prefer GOOGLE_CLOUD_PROJECT)
# GCP_PROJECT_ID=
# FIRESTORE_PROJECT_ID=
# Per-call Firestore RPC timeout in seconds
# FIRESTORE_RPC_TIMEOUT_SECONDS=
# Path to a service-account key for local dev only (Cloud Run uses ADC)
# GOOGLE_APPLICATION_CREDENTIALS=

# ── AI models and prompts ──────────────────────────────────────────────────
# Model for chat-to-form extraction
# THO_EXTRACTION_MODEL=gemini-2.0-flash-001
# Model for the lead-name backfill tool
# THO_BACKFILL_MODEL=gemini-2.0-flash-001
# Ops Copilot model override (default from config.yaml)
# COPILOT_MODEL=
# Max seconds for one agent run (default 45)
# AI_RUN_TIMEOUT=45
# Override directory for prompts/ files
# THO_PROMPT_DIR=

# ── Site and server ────────────────────────────────────────────────────────
# Canonical public origin for SEO tags and redirects (default https://www.texashomeoutlet.com)
# CANONICAL_PUBLIC_URL=https://www.example.com
# Serve /docs and /openapi.json on Cloud Run (1 = on; always on locally)
# EXPOSE_API_DOCS=0
# HTTP port (Cloud Run sets this; default 8080)
# PORT=8080
# Old website base URL used by the legacy inventory crawler
# LEGACY_INVENTORY_BASE_URL=https://www.example.com
# Path to the local SEO competitor registry file
# COMPETITOR_REGISTRY_PATH=
# Single partner API key (THO_API_KEY_* variants above are also accepted)
# THO_API_KEY=

# ── Local data and migration tools (paths outside the repo; see docs/LOCAL_DATA.md) ─
# THO_LOCAL_DATA_DIR=data/local_private
# FCD_MIGRATION_CSV_PATH=
# FCD_MIGRATION_JSON_PATH=

# ── Ops scripts (scripts/) ─────────────────────────────────────────────────
# Base URL for scripts/live_monitoring_check.py
# THO_BASE_URL=https://www.example.com
# Base URL for scripts/probe_healthz.py
# PROBE_URL=https://www.example.com
# Admin PIN for scripts/doccenter_smoke.py (never commit a real value)
# THO_ADMIN_PIN=
# Webhook for lead alerts in scripts/sync_leads_to_bigquery.py
# THO_LEAD_ALERT_WEBHOOK=
# Environment label for scripts/generate_api_reference.py (default development)
# ENVIRONMENT=development

# ── Frontend build (Vite) ──────────────────────────────────────────────────
# Browser Sentry DSN baked in at build time (blank = disabled)
# VITE_SENTRY_DSN=

# ── Set by the platform or CI; do not set by hand ──────────────────────────
# Release identifiers reported by /healthz/ and Sentry
# APP_VERSION=
# GIT_SHA=
# SOURCE_COMMIT=
# GITHUB_SHA=
# Cloud Run runtime metadata (presence of K_SERVICE means "running on Cloud Run")
# K_SERVICE=
# K_REVISION=
# K_CONFIGURATION=
# Set by pytest while a test runs
# PYTEST_CURRENT_TEST=
