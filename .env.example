# Google Cloud / Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
THO_GEMINI_MODEL=gemini-2.5-flash
THO_GEMINI_FALLBACK_MODELS=gemini-2.0-flash-001
THO_IMAGEN_MODEL=imagen-4.0-generate-001
THO_IMAGEN_FALLBACK_MODELS=imagen-3.0-generate-002,imagen-3.0-generate-001
THO_VEO_MODEL=veo-3.0-fast-generate-001

# Admin Authentication (required in production)
# Generate hash: python -c "import hashlib; print(hashlib.sha256(b'YOUR_PIN').hexdigest())"
ADMIN_PIN_HASH=
ADMIN_TOKEN_TTL=7200

# Email Service (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx
# Resend verified sender (must be domain-verified in Resend dashboard before use)
RESEND_FROM="Texas Home Outlet <noreply@texashomeoutlet.com>"
# Public origin used to build absolute download URLs in customer emails (no trailing slash)
PUBLIC_SITE_URL=https://your-app.run.app

# Social publishing (fail-closed; leave disabled until accounts are approved)
THO_SOCIAL_PUBLISH_ENABLED=0
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# CORS — comma-separated allowed origins (defaults to Cloud Run URLs)
ALLOWED_ORIGINS=https://your-app.run.app

# Rate Limiting
RATE_LIMIT_RPM=60
MAX_REQUEST_BODY_BYTES=1048576

# Redis Cache (optional — falls back to in-memory)
REDIS_HOST=
REDIS_PORT=6379
