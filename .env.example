# Google Cloud / Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Admin Authentication (required in production)
# Generate hash: python -c "import hashlib; print(hashlib.sha256(b'YOUR_PIN').hexdigest())"
ADMIN_PIN_HASH=
ADMIN_TOKEN_TTL=7200

# Email Service (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM=Texas Home Outlet <noreply@yourdomain.com>

# Gmail Inbound Sync (gated; see docs/integration/gmail-inbound-setup.md)
# Flip GMAIL_INBOUND_ENABLED=true ONLY after Mark/Celeste finish the Workspace
# admin checklist and the service account JSON is mounted from Secret Manager.
GMAIL_INBOUND_ENABLED=false
GMAIL_SERVICE_ACCOUNT_JSON=
GMAIL_DELEGATED_USER=ops@texashomeoutlet.com
GMAIL_INBOUND_LABEL=inbox

# CORS — comma-separated allowed origins (defaults to Cloud Run URLs)
ALLOWED_ORIGINS=https://your-app.run.app

# Rate Limiting
RATE_LIMIT_RPM=60
MAX_REQUEST_BODY_BYTES=1048576

# Redis Cache (optional — falls back to in-memory)
REDIS_HOST=
REDIS_PORT=6379
